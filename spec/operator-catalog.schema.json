{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RxJS BDD Operator Catalog",
  "type": "object",
  "required": [
    "version",
    "operators"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operator",
          "rules"
        ],
        "properties": {
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "given",
                "when",
                "then"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "state",
                    "event",
                    "completion",
                    "error",
                    "unsubscription",
                    "cancellation"
                  ]
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
